{
  "datasets": [
    {
      "name": "golden_sms",
      "displayName": "Golden SMS",
      "config": {
        "version": "1.1",
        "source": "catalog_au.golden.golden_sms",
        "dimensions": [
          {
            "name": "cliente",
            "expr": "cliente"
          },
          {
            "name": "producto",
            "expr": "producto"
          },
          {
            "name": "remitente",
            "expr": "usuario_creacion"
          },
          {
            "name": "periodo",
            "expr": "periodo"
          },
          {
            "name": "mes",
            "expr": "mes"
          },
          {
            "name": "anio",
            "expr": "anio"
          }
        ],
        "measures": [
          {
            "name": "total_sms",
            "expr": "SUM(total_sms)"
          }
        ]
      }
    },
    {
      "name": "golden_email",
      "displayName": "Golden Email",
      "config": {
        "version": "1.1",
        "source": "catalog_au.golden.golden_email",
        "dimensions": [
          {
            "name": "cliente",
            "expr": "cliente"
          },
          {
            "name": "sender",
            "expr": "senderaddress"
          },
          {
            "name": "mes",
            "expr": "mes"
          },
          {
            "name": "anio",
            "expr": "anio"
          },
          {
            "name": "periodo",
            "expr": "CONCAT(CAST(anio AS STRING), '-', LPAD(CAST(mes AS STRING), 2, '0'))"
          }
        ],
        "measures": [
          {
            "name": "total_emails",
            "expr": "SUM(total)"
          },
          {
            "name": "entregado",
            "expr": "SUM(entregado)"
          },
          {
            "name": "fallido",
            "expr": "SUM(fallido)"
          }
        ]
      }
    }
  ],
